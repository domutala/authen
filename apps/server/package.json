{
  "name": "@authen/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@authen/adapter-memory": "workspace:*",
    "@authen/adapter-postgres": "workspace:*",
    "@authen/core": "workspace:*",
    "@authen/protocol-oauth-oidc": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "@authen/provider-email-otp": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "env-schema": "^8.0.0",
    "fastify": "^5.6.1",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsdown": "^0.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
