HOST=127.0.0.1
PORT=3000
# AUTHEN_ISSUER=https://auth.example.com

# Sans DATABASE_URL : stockage mémoire (développement uniquement).
# Avec DATABASE_URL : migrations appliquées au démarrage, AUTHEN_SIGNING_SECRET obligatoire.
# DATABASE_URL=postgres://user:password@localhost:5432/authen
# Chiffre les clés de signature stockées en base. Ne pas le changer : les clés deviendraient illisibles.
# AUTHEN_SIGNING_SECRET=<au moins 32 caractères aléatoires>
# Rotation automatique de la clé de signature (jours, défaut 90).
# AUTHEN_KEY_ROTATION_DAYS=90

# true derrière un reverse proxy : l'IP (rate limiting) est lue dans X-Forwarded-For.
# AUTHEN_TRUST_PROXY=false

OIDC_CLIENT_ID=authen-web
OIDC_REDIRECT_URI=http://localhost:3001/callback
